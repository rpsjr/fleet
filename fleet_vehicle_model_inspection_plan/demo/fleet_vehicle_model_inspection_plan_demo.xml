<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Local Inspection Items (replicating what tests use, as they might not be available) -->
    <record id="demo_inspection_item_lights" model="fleet.vehicle.inspection.item">
        <field name="name">Lights</field>
    </record>
    
    <record id="demo_inspection_item_mirrors" model="fleet.vehicle.inspection.item">
        <field name="name">Mirrors</field>
    </record>

    <!-- Inspection Plans -->
    <record
        id="fleet_vehicle_model_inspection_plan_demo_1"
        model="fleet.vehicle.model.inspection.plan"
    >
        <field name="model_id" ref="fleet.model_opel_corsa" />
        <field name="item_id" ref="demo_inspection_item_lights" />
        <field name="interval_km">10000</field>
        <field name="interval_months">12</field>
    </record>

    <record
        id="fleet_vehicle_model_inspection_plan_demo_2"
        model="fleet.vehicle.model.inspection.plan"
    >
        <field name="model_id" ref="fleet.model_opel_corsa" />
        <field name="item_id" ref="demo_inspection_item_mirrors" />
        <field name="interval_km">15000</field>
        <field name="interval_months">24</field>
    </record>
    
    <record
        id="fleet_vehicle_model_inspection_plan_demo_3"
        model="fleet.vehicle.model.inspection.plan"
    >
        <field name="model_id" ref="fleet.model_audi_a1" />
        <field name="item_id" ref="demo_inspection_item_lights" />
        <field name="interval_km">12000</field>
        <field name="interval_months">12</field>
    </record>
</odoo>
