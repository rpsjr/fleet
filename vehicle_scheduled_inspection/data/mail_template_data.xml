<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- WhatsApp Template -->
        <record
            id="wa_template_convite_manutencao_programada"
            model="whatsapp.template"
        >
            <field name="name">convite_manutencao_programada</field>
            <field name="language">pt_BR</field>
            <field
                name="model_id"
                ref="fleet_vehicle_inspection.model_fleet_vehicle_inspection"
            />
            <field
                name="body"
            ><![CDATA[Olá, {{1}}!

🚙  {{2}}!

🧰 Está na hora da revisão programada de {{3}}km!

Data: {{4}}
Hora: 7h30 às 11h
Local: Centro Automotivo Costa Cabral

Itens de manutenção:
{{5}} Oléo de motor
{{6}} Filtro de óleo
{{7}} Filtro de combustível
{{8}} Filtro de ar do motor
{{9}} Outros

*Confirme já!*]]></field>
        </record>

        <!-- Email Template -->
        <record id="mail_template_convite_manutencao_programada" model="mail.template">
            <field name="name">Convite de Manutenção Programada</field>
            <field
                name="model_id"
                ref="fleet_vehicle_inspection.model_fleet_vehicle_inspection"
            />
            <field
                name="subject"
            >Manutenção Programada: ${object.vehicle_id.name}</field>
            <field name="partner_to">${object.vehicle_id.driver_id.id}</field>
            <field name="body_html" type="html">
                <div style="background:#F0F0F0;color:#515166;padding:10px 0px;font-family:Arial,Helvetica,sans-serif;font-size:14px;">
                    <table style="width:600px;margin:5px auto;">
                        <tbody>
                            <tr>
                                <td>
                                    <a href="/"><img src="/web/binary/company_logo" style="vertical-align:baseline;max-width: 100px; width: auto; height: auto;" alt="Logo" /></a>
                                </td>
                                <td style="text-align:right;vertical-align:middle;">
                                    Revisão Programada
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table style="width:600px;margin:0px auto;background:white;border:1px solid #e1e1e1;">
                        <tbody>
                            <tr>
                                <td style="padding:15px 20px 10px 20px;">
                                    <p>Olá, ${object.vehicle_id.driver_id.name or ''}&#160;</p>
                                    <p><br/></p>
                                    <p style="margin-left:1.5em;">
                                        🚙 <strong>${object.vehicle_id.name or ''}</strong>
                                    </p>
                                    <p style="margin-left:1.5em;">
                                        🧰 Está na hora da revisão programada de <strong>${ctx.get('forecast_km', '')}km</strong>!
                                    </p>
                                    <p style="margin-left:1.5em;">
                                        Data: ${ctx.get('inspection_date', '')}<br/>
                                        Hora: 7h30 às 11h<br/>
                                        Local: Centro Automotivo Costa Cabral<br/><br/>
                                        Itens de manutenção programados:
                                    </p>
                                    <ul style="margin-left:1.5em;">
                                        % for item in ctx.get('inspection_items', []):
                                            <li>${item.name}</li>
                                        % endfor
                                    </ul>
                                    <p style="margin-left:1.5em;">
                                        <br/>
                                        <strong>Confirme já!</strong>
                                    </p>
                                    <p style="margin-left:1.5em;"><br/></p>
                                    <p style="margin-left:1.5em;">Se tiver alguma dúvida, não hesite em contactar-nos.</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </field>
            <field name="auto_delete" eval="True" />
        </record>
    </data>
</odoo>
